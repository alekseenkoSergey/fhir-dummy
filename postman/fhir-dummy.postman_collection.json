    {
      "name": "Observation",
      "item": [
        {
          "name": "Create Observation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"FHIR resource type\", function () {",
                  "        pm.expect(pm.response.json().resourceType).to.eql(\"Observation\");",
                  "    });",
                  "}",
                  "if (pm.response.code === 201) {",
                  "    const observation = pm.response.json();",
                  "    pm.test(\"Created Observation has an ID\", function () {",
                  "        pm.expect(observation.id).to.be.a(\"string\").and.not.empty;",
                  "    });",
                  "    if (typeof observation.id === \"string\" && observation.id.length > 0) {",
                  "        pm.environment.set(\"observationId\", observation.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/fhir+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"final\",\n  \"code\": \"8310-5\",\n  \"value\": 36.6,\n  \"unit\": \"Cel\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/fhir/observation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fhir",
                "observation"
              ]
            },
            "description": "Creates a synthetic temperature Observation. Saves the returned id to the selected environment as observationId."
          },
