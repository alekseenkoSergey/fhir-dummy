{
  "info": {
    "_postman_id": "ba4f4648-ed13-4a80-80d1-c5c5b74bbe96",
    "name": "FHIR Dummy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Current FHIR R5 proxy endpoints. Select FHIR Dummy Local environment. Patient and Device use composite IDs. Emulator serves source JSON fixtures."
  },
  "item": [
    {
      "name": "Metadata",
      "item": [
        {
          "name": "Get metadata (FHIR JSON)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/fhir+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fhir/metadata?_format=json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fhir",
                "metadata"
              ],
              "query": [
                {
                  "key": "_format",
                  "value": "json"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"FHIR resource type\", function () {",
                  "        pm.expect(pm.response.json().resourceType).to.eql(\"CapabilityStatement\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get metadata (HTML)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fhir/metadata?_format=html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fhir",
                "metadata"
              ],
              "query": [
                {
                  "key": "_format",
                  "value": "html"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"HTML response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
